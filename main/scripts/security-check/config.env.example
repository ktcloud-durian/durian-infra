# 보안 점검기 설정 → Monitor EC2의 /etc/durian-check/config.env (root 600)로 복사해서 채움
# 이 파일에는 이름·명단만 넣음. 비밀번호·키·토큰은 넣지 않음 (OpenStack 자격 증명은 clouds.yaml에 따로).
# 실제 명단을 채운 config.env는 저장소에 올리지 않음 (공개 저장소).

NAME=durian
REGION=ap-northeast-2

# --- AWS ---
# 7번: AdministratorAccess가 붙어도 되는 사용자·그룹·역할 이름 (공백으로 구분)
ADMINS=""
# 8번: 액세스 키를 가져도 되는 사용자 (IAM-07). 비우면 명단 검사는 건너뛰고 90일만 봄
KEY_USERS=""
# 22c번: Terraform 상태 버킷. 비우면 durian-tfstate-<계정ID>
STATE_BUCKET=""
# 25d번: us-east-1 IAM 변경·루트 로그인 탐지를 켰으면 true (global_detection_enabled)
GLOBAL=false
# 25b번: GuardDuty를 켰으면 true. 계정에서 못 써서 기본은 false → SKIP (예외 EX-10)
GUARDDUTY=false

# --- OpenStack ---
# 점검할 사이트 (clouds.yaml의 durian-<사이트>, durian-<사이트>-sys)
OS_SITES="a b"
OS_CLIENT_CONFIG_FILE=/etc/durian-check/clouds.yaml
# OS-A1: 팀원 6명 + 서비스 계정 이름 (공백으로 구분)
TEAM_USERS=""
# OS-A2: admin 역할을 가져도 되는 계정 (OpenStack 인프라 담당 + Kolla 서비스 계정 허용 목록)
APPROVED_ADMINS=""
# OS-R3: Floating IP가 붙어도 되는 서버 이름 (방화벽 정책 정의서의 허용 목록)
FIP_ALLOW_SERVERS=""
# OS-R3: 이 글자가 이름에 들어간 서버는 Floating IP가 있으면 무조건 위반
DB_NAME_PATTERN=db
# OS-R2: managed-rule-ids-<사이트>.txt (Terraform 관리 규칙 ID 목록)를 둔 폴더
MANAGED_IDS_DIR=/etc/durian-check
