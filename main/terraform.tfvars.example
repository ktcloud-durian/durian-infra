# cp terraform.tfvars.example terraform.tfvars  (Git에 올라가지 않음)
instances = {
  k3s = { role = "k3s", instance_type = "m7i-flex.large" }
  # runner = { role = "runner", instance_type = "c7i-flex.large" }
}

# S3 (정해지면 용도 이름만 추가)
# buckets = ["upload", "backup"]

# ALB access policy (EX-01)
# Verification: approved team IPv4 /32 only
# aws_alb_enabled = true
aws_alb_public_access = false
aws_alb_allowed_cidrs = []

